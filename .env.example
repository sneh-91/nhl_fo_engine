CAPWAGES_API_KEY=your_capwages_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
FRONTEND_ORIGIN=http://localhost:5173
NHL_API_BASE_URL=https://api-web.nhle.com/v1/
CAPWAGES_API_BASE_URL=https://capwages.com/api/gateway/v1/
SOURCE_REQUEST_TIMEOUT_SECONDS=20
MAX_PARALLEL_SOURCE_REQUESTS=8
ROSTER_CACHE_TTL_SECONDS=900
PLAYER_CACHE_TTL_SECONDS=900
OPENAI_ANSWER_MODEL=gpt-5.4-mini
OPENAI_CLASSIFIER_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_JUDGE_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=
OPENAI_MAX_TOOL_ROUNDS=8
OPENAI_MAX_OUTPUT_TOKENS=2000
NHL_RULES_RAG_ENABLED=true
# Relative paths are resolved from the repo root (not the backend/ working directory).
NHL_RULES_CHROMA_PATH=data/nhl/vector_store/chroma
NHL_RULES_CHROMA_COLLECTION=nhl_rules
NHL_RULES_TOP_K=6
